# Copy this file to .env and adjust for your setup
# .env is git-ignored; this file is documentation

# Server hostname the client connects to (default: chinesecheckers.webhop.me)
# PUBLIC_SERVER_HOST=127.0.0.1

# Port for both client and server (default: 5555)
# SERVER_PORT=5555

# Address the server binds to (default: 0.0.0.0)
# LISTEN_HOST=0.0.0.0

# Enable the WebSocket listener for browser clients (default: 1)
# ENABLE_WEBSOCKET_SERVER=1

# WebSocket listener host/port (defaults: LISTEN_HOST and SERVER_PORT + 1)
# WEBSOCKET_LISTEN_HOST=0.0.0.0
# WEBSOCKET_PORT=5556
